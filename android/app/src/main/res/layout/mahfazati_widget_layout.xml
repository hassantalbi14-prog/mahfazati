<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a6b4a"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_acc_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اختر حساب من الإعدادات"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:textDirection="rtl"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_acc_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textDirection="rtl"
        android:gravity="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/widget_ind_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مؤشر الصحة"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        android:textDirection="rtl"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_ind_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#e8ab2e"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textDirection="rtl"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_open_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#26FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="فتح محفظتي ›"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textDirection="rtl"
        android:gravity="center" />

</LinearLayout>
